<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="ay262_maze">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://ay262_maze/meshes/map07.glb</uri>
            <!-- Width at scale of 1 is 15.270 m but the width needs to be 3.3 m -->
            <scale>0.22 0.22 0.22</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://ay262_maze/meshes/map07.glb</uri>
            <scale>0.22 0.22 0.22</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
